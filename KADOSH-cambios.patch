+
+
+/* Kadosh shell: quiet surfaces, editorial hierarchy and warm neutral accents. */
+.skip-link { position: fixed; left: 16px; top: -80px; z-index: 300; padding: 14px 20px; background: var(--panel); border: 2px solid var(--focus); border-radius: 6px; }
+.skip-link:focus { top: 12px; }
+.sidebar {
+  --panel: #151515; --text: #FFFFFF; --muted: #BBB5AD;
+  --border: #35322E; --hover: #242321; --soft: #302C27; --primary: #E8E6E3;
+  width: 252px; padding: 32px 18px 18px; background: var(--kadosh-black); color: var(--kadosh-white);
+}
+.brand { gap: 12px; font-size: 23px; font-weight: 500; letter-spacing: 3px; }
+.brand-icon, .dark .brand-icon {
+  width: 38px; height: 42px; padding: 0; display: grid; place-items: center;
+  border: 1px solid #A89B8C; border-radius: 2px; background: transparent;
+  color: #E8E6E3; font-family: Georgia, serif; font-size: 30px; font-weight: 400; letter-spacing: 0;
+}
+.brand span:not(.brand-icon):not(.login-monogram) { font-size: 9px; color: #BBB5AD; letter-spacing: 1.9px; margin-top: 6px; }
+.workspace { margin: 32px 0 26px; padding: 13px 10px; background: #1D1C1A; border-radius: 6px; }
+.workspace-avatar { background: #35302A; color: #D4C7B5; border-radius: 3px; }
+.nav-label { font-size: 10px; letter-spacing: 2px; margin-bottom: 13px; }
+.sidebar nav { gap: 4px; }
+.sidebar nav a { min-height: 44px; padding: 11px 14px; font-size: 13px; border-radius: 5px; }
+.sidebar nav a.active { background: #E8E6E3; color: #151515; font-weight: 600; }
+.sidebar nav a.active:before { background: #A89B8C; left: -18px; width: 3px; height: 24px; }
+.sidebar nav a svg { stroke-width: 1.65; }
+.sidebar .avatar { background: #35302A; color: #DDD1C0; }
+.sidebar .profile strong { max-width: 155px; font-size: 12px; }
+.sidebar-bottom > button { width: 100%; min-height: 44px; border-radius: 5px; }
+.sidebar-bottom > button:hover { background: #242321; color: #FFFFFF; }
+.main-shell { margin-left: 252px; }
+.topbar { height: 78px; font-size: 12px; background: var(--panel); }
+.topbar .live-dot { display: none; }
+.main-shell main { padding: 36px; }
+.heading { margin-bottom: 28px; }
+.eyebrow { font-size: 10px; letter-spacing: 2px; margin-bottom: 12px; }
+h1 { font-size: 32px; font-weight: 550; letter-spacing: -1.1px; }
+h2 { font-size: 17px; font-weight: 600; }
+.heading p { font-size: 13px; line-height: 1.7; max-width: 640px; }
+.btn { border-radius: 6px; min-height: 44px; padding: 11px 17px; font-size: 12px; }
+.dark .btn:not(.secondary) { color: var(--on-primary); }
+.btn:hover { filter: none; box-shadow: 0 3px 10px #15151512; }
+.btn:not(.secondary):hover { opacity: .88; }
+.btn.secondary:hover { background: var(--hover); border-color: var(--muted); }
+.panel, .stat-card { border-radius: 9px; box-shadow: var(--shadow); }
+.panel { padding: 24px; }
+.panel.no-pad { padding: 0; }
+.welcome-strip { padding: 14px 18px; border-radius: 6px; background: var(--soft); font-size: 12px; }
+.stat-grid { gap: 18px; }
+.stat-card { padding: 23px; }
+a.stat-card:hover { border-color: #A89B8C; }
+.stat-card > div { font-size: 12px; color: var(--muted); gap: 12px; }
+.stat-card > strong { font-size: 36px; font-weight: 500; margin: 20px 0 12px; }
+.stat-card > small { line-height: 1.5; }
+.metric-strip { margin: 22px 0; }
+.metric-strip strong { font-size: 23px; font-weight: 500; font-variant-numeric: tabular-nums; }
+.chart-legend i { background: var(--chart-entry); }
+.chart-legend i.orange { background: var(--chart-exit); }
+.chart-grid, .bottom-grid { gap: 22px; }
+.text-link { font-size: 12px; font-weight: 600; text-decoration: underline; text-underline-offset: 4px; }
+.table-wrap { overscroll-behavior-x: contain; scrollbar-color: #A89B8C transparent; }
+.table-wrap:focus-visible { outline: 2px solid var(--focus); outline-offset: -2px; }
+table { font-size: 13px; }
+th { padding: 15px 20px; font-size: 11px; letter-spacing: .35px; font-weight: 600; }
+td { padding: 18px 20px; line-height: 1.55; overflow-wrap: break-word; }
+td strong { font-size: 13px; }
+td small { font-size: 11px; line-height: 1.5; }
+.product-cell > div { min-width: 120px; }
+.badge { font-size: 11px; padding: 5px 9px; border-radius: 4px; font-weight: 600; }
+.filters { gap: 14px; padding: 20px; align-items: flex-end; background: var(--panel); }
+.filters .search-input { min-width: min(260px, 100%); }
+input, select, textarea { min-height: 44px; font-size: 13px; padding: 11px 12px; border-radius: 5px; border-color: var(--control-border); }
+select { padding-right: 28px; }
+textarea { resize: vertical; line-height: 1.6; }
+.field > label { font-size: 12px; font-weight: 550; margin-bottom: 8px; }
+.filters > select { max-width: 250px; }
+.stock-tabs { gap: 10px; }
+.stock-tabs button { min-height: 44px; font-size: 12px; border-radius: 5px; }
+.stock-tabs button.active { background: var(--primary); color: var(--on-primary); border-color: var(--primary); }
+.empty { padding: 54px 24px; gap: 14px; }
+.empty svg { color: #A89B8C; stroke-width: 1.3; }
+.empty strong { font-size: 14px; }
+.empty p { line-height: 1.6; }
+.error-box { flex-wrap: wrap; font-size: 13px; line-height: 1.6; }
+.modal { border-radius: 10px; padding: 28px; max-height: calc(100dvh - 48px); }
+.modal-head { padding-bottom: 20px; border-bottom: 1px solid var(--border); margin-bottom: 24px; gap: 16px; }
+.modal h2 { font-size: 22px; font-weight: 500; }
+.form-actions { padding-top: 20px; margin-top: 20px; }
+.form-note, .report-note { font-size: 12px; line-height: 1.7; }
+.form-note svg, .report-note svg { flex-shrink: 0; }
+fieldset.operation-grid { border: 0; padding: 0; margin: 0; min-width: 0; }
+.product-results > button { min-height: 76px; }
+.product-results > button > div { min-width: 0; overflow-wrap: anywhere; }
+.product-results > button.selected { box-shadow: inset 3px 0 #A89B8C; }
+.product-results > button:disabled { opacity: .7; }
+.category-card { gap: 18px; }
+.category-card h2 { overflow-wrap: anywhere; }
+.toast { font-size: 13px; line-height: 1.6; }
+.toast button { min-width: 36px; min-height: 36px; }
+.check-field { line-height: 1.6; min-height: 44px; }
+.pager { flex-wrap: wrap; font-size: 12px; }
+footer { gap: 16px; line-height: 1.7; }
+
+/* An editorial login, built with the project's existing components. */
+.login-page { grid-template-columns: 1.05fr 1fr; }
+.login-art { background: var(--kadosh-black); color: var(--kadosh-white); min-height: 760px; padding: 52px 9%; }
+.login-art:after { border-radius: 0; width: 350px; height: 550px; bottom: -340px; right: -100px; transform: rotate(25deg); box-shadow: 0 0 0 55px #A89B8C08; }
+.login-art .brand { font-size: 26px; letter-spacing: 4px; }
+.login-monogram { font-family: Georgia, serif; font-size: 43px; letter-spacing: 0; line-height: 1; color: #D4C7B5; border-right: 1px solid #655B50; padding-right: 20px; margin-right: 5px; }
+.login-art .brand span:not(.login-monogram) { color: #C3B9AD; font-size: 9px; }
+.pill { border: 0; border-radius: 0; padding: 0 0 12px; border-bottom: 1px solid #A89B8C; font-size: 10px; letter-spacing: 2px; margin-bottom: 24px; }
+.login-art h1 { font-family: Georgia, 'Times New Roman', serif; font-size: clamp(48px, 4.6vw, 76px); font-weight: 400; letter-spacing: -2px; line-height: 1.12; }
+.login-art h1 em { font-style: italic; color: #C3B5A3; }
+.login-art p { color: #C9C3BA; font-size: 14px; max-width: 400px; line-height: 1.9; margin-top: 26px; }
+.art-cards { gap: 24px; margin-top: 40px; }
+.art-cards > div { background: transparent; padding: 20px 0; border: 0; border-top: 1px solid #524A40; border-radius: 0; max-width: 220px; }
+.art-cards strong { font-size: 12px; line-height: 1.6; }
+.art-cards span { font-size: 11px; line-height: 1.7; }
+.login-form { background: var(--bg); padding: 48px; }
+.login-box { max-width: 390px; }
+.login-box h2 { font-size: 34px; font-weight: 500; }
+.login-box > p { font-size: 14px; line-height: 1.7; }
+.login-box input { height: 50px; background: var(--panel); }
+.login-box .btn { min-height: 50px; justify-content: space-between; }
+.login-box .field { margin-bottom: 24px; }
+.password-field button { width: 44px; height: 44px; top: 3px; right: 3px; display: grid; place-items: center; border-radius: 4px; }
+.password-field input { padding-right: 52px; }
+.login-help { font-size: 12px; line-height: 1.6; }
+.login-error { padding: 14px; margin-bottom: 22px; color: var(--danger); background: var(--panel); border: 1px solid currentColor; border-radius: 5px; font-size: 13px; line-height: 1.6; }
+
+@media (max-width: 1200px) {
+  .sidebar { width: 230px; padding-left: 16px; padding-right: 16px; }
+  .main-shell { margin-left: 230px; }
+  .main-shell main { padding: 28px 24px; }
+  .stat-card { padding: 19px; }
+  .login-art { padding: 40px; }
+  .login-form { padding: 36px; }
+}
+@media (max-width: 1000px) {
+  .chart-grid { grid-template-columns: 1fr; }
+  .heading { flex-wrap: wrap; }
+  .heading > div:first-child { flex: 1 1 280px; }
+}
+@media (max-width: 760px) {
+  .sidebar { width: min(290px, calc(100vw - 32px)); left: 0; transform: translateX(-100%); visibility: hidden; transition: transform .2s, visibility .2s; }
+  .sidebar.open { transform: translateX(0); visibility: visible; }
+  .main-shell { margin-left: 0; }
+  .topbar { height: 68px; }
+  .topbar > div { gap: 10px; }
+  .icon-btn { min-width: 44px; width: 44px; height: 44px; }
+  .sidebar .brand { font-size: 20px; letter-spacing: 2px; }
+  .sidebar .brand-icon { width: 32px; flex-shrink: 0; }
+  .sidebar .mobile-close { min-width: 36px; width: 36px; }
+  .main-shell main { padding: 26px 18px; }
+  .heading { gap: 18px; margin-bottom: 24px; }
+  .heading h1 { font-size: 28px; overflow-wrap: anywhere; }
+  .heading .btn { font-size: 12px; padding: 11px 15px; }
+  .heading .btn svg { display: block; }
+  .welcome-strip { flex-wrap: wrap; gap: 10px; line-height: 1.6; }
+  .welcome-strip > span:not(.live-dot) { display: inline; }
+  .welcome-strip a { margin-left: 0; }
+  .stat-grid { gap: 12px; }
+  .stat-card { padding: 17px; }
+  .stat-card > div { font-size: 12px; align-items: flex-start; }
+  .stat-card > div svg { flex-shrink: 0; width: 17px; }
+  .stat-card > strong { font-size: 30px; margin: 18px 0 10px; }
+  .stat-card > small { font-size: 11px; }
+  .metric-strip { grid-template-columns: 1fr; }
+  .metric-strip > div { padding: 18px; }
+  .metric-strip > div:last-child { grid-column: auto; }
+  .metric-strip > div:not(:last-child) { border-bottom: 1px solid var(--border); }
+  .metric-strip > div:last-child { border-top: 0; }
+  .metric-strip > div:after { display: none; }
+  .metric-strip strong { font-size: 23px; }
+  .panel { padding: 20px; }
+  .panel.no-pad { padding: 0; }
+  .filters { padding: 16px; gap: 14px; }
+  .filters .field, .filters > .field { min-width: 125px; }
+  .filters .search-input { min-width: 0; }
+  .filters > select { max-width: 100%; }
+  .stock-tabs { gap: 8px; }
+  .stock-tabs button { flex: 1 1 auto; padding: 11px 12px; }
+  .category-grid { grid-template-columns: 1fr; }
+  .category-card { padding: 22px; }
+  .category-card h2 { font-size: 19px; }
+  td, th { padding: 15px; }
+  .table-wrap table { min-width: 640px; }
+  .modal { padding: 22px; max-height: calc(100dvh - 20px); }
+  .variant-row > div { min-width: 140px; }
+  .form-actions { flex-wrap: wrap; }
+  .form-actions .btn { flex: 1; }
+  .login-page { grid-template-columns: 1fr; }
+  .login-art { min-height: 0; padding: 25px; }
+  .login-art .brand { font-size: 24px; }
+  .login-monogram { font-size: 36px; padding-right: 16px; }
+  .login-form { min-height: calc(100dvh - 95px); padding: 40px 24px; }
+  .login-box h2 { font-size: 30px; }
+  footer { flex-direction: column; padding: 0 18px 22px; gap: 4px; }
+  footer span { display: inline; }
+}
+@media (max-width: 380px) {
+  .stat-grid { grid-template-columns: 1fr; }
+  .heading .row-actions { flex-wrap: wrap; }
+  .filters .field, .filters > .field, .filters > select { flex-basis: 100%; }
+}
+
+.login-art .brand .login-monogram { font-size: 43px; }
+@media (max-width: 760px) { .login-art .brand .login-monogram { font-size: 36px; } }
+
+.filters.advanced { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); }
+.filters.advanced .field, .filters.advanced .search-input { min-width: 0; width: 100%; }
+.filters.advanced .search-input input { width: 100%; }
+[aria-label="Tabla de resultados del reporte"] table { min-width: 1100px; }
+@media (max-width: 1000px) { .filters.advanced { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
+@media (max-width: 380px) { .filters.advanced { grid-template-columns: minmax(0, 1fr); } }
+
+.table-hint { display: none; }
+@media (max-width: 760px) { .table-hint { display: block; padding: 12px 15px; color: var(--muted); background: var(--hover); border-bottom: 1px solid var(--border); font-size: 11px; line-height: 1.6; } }
